{
  "schemaVersion": 1,
  "id": "example.vae-mnist",
  "version": "0.1.0",
  "name": "Autoencoder MNIST",
  "description": "MNIST images paired with themselves for reconstruction.",
  "parameters": [
    {
      "name": "B",
      "type": "integer",
      "required": true
    },
    {
      "name": "num_workers",
      "type": "integer",
      "required": false,
      "default": 0
    },
    {
      "name": "train_size",
      "type": "number",
      "required": false,
      "default": 0.8
    }
  ],
  "batch": {
    "inputs": {
      "image": {
        "shape": ["B", 1, 28, 28],
        "dtype": "float32"
      }
    },
    "targets": {
      "target": {
        "shape": ["B", 1, 28, 28],
        "dtype": "float32"
      }
    }
  }
}
