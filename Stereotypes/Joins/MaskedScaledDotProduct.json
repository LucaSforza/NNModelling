{
  "category": "Join",
  "pythonClassName": "ops.MaskedScaledDotProduct",
  "params": {
    "d_model": { "type": "int", "default": "512" }
  },
  "view": {
    "color": "#e74c3c",
    "width": 30,
    "height": 30
  },
  "type_signature": {
    "version": 2,
    "inputs": [
      {
        "lower": 1,
        "upper": 1,
        "label": "Q",
        "pattern": { "kind": "pattern", "dims": [
          { "kind": "symbolic", "name": "B", "scope": "global" },
          { "kind": "symbolic", "name": "L", "scope": "local" },
          { "kind": "symbolic", "name": "D", "scope": "local" }
        ] }
      },
      {
        "lower": 1,
        "upper": 1,
        "label": "K",
        "pattern": { "kind": "pattern", "dims": [
          { "kind": "symbolic", "name": "B", "scope": "global" },
          { "kind": "symbolic", "name": "S", "scope": "local" },
          { "kind": "symbolic", "name": "D", "scope": "local" }
        ] }
      }
    ],
    "output": { "kind": "pattern", "dims": [
      { "kind": "symbolic", "name": "B", "scope": "global" },
      { "kind": "symbolic", "name": "L", "scope": "local" },
      { "kind": "symbolic", "name": "S", "scope": "local" }
    ] },
    "constraints": [{
      "condition": "$D == param.d_model",
      "message": "Q and K feature dimensions must equal d_model"
    }],
    "from_dtype": "dtype(input(0, 0))",
    "to_dtype": "dtype(input(0, 0))"
  }
}
