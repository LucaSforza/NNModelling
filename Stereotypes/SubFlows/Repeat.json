{
  "category": "Subflow",
  "pythonClassName": "ops.Repeat",
  "view": {
    "color": "#9b59b6",
    "width": 400,
    "height": 300
  },
  "params": {
    "iterations": {
      "type": "int",
      "default": "1",
      "position": "top"
    }
  },
  "type_signature": {
    "version": 2,
    "inputs": [
      {
        "lower": 1,
        "upper": 1,
        "pattern": {
          "kind": "pattern",
          "dims": [{ "kind": "wildcard" }]
        }
      }
    ],
    "output": {
      "kind": "computed_shape",
      "expr": "shape(iterate(param.iterations, input(0, 0), x => apply(x)))"
    },
    "to_dtype": "dtype(iterate(param.iterations, input(0, 0), x => apply(x)))",
    "constraints": [
      {
        "condition": "is_integer(param.iterations) and param.iterations >= 1",
        "message": "iterations must be a positive integer"
      }
    ]
  }
}
