{
  "category": "Layer",
  "pythonClassName": "nn.Flatten",
  "view": {
    "color": "#a9a9a9",
    "width": 100,
    "height": 50
  },
  "params": {
    "start_dim": {
      "type": "int",
      "default": "1"
    },
    "end_dim": {
      "type": "int",
      "default": "-1"
    }
  },
  "type_signature": {
    "version": 2,
    "inputs": [
      {
        "lower": 1,
        "upper": 1,
        "pattern": {
          "kind": "pattern",
          "dims": [
            {
              "kind": "symbolic",
              "name": "B",
              "scope": "global"
            },
            {
              "kind": "wildcard"
            }
          ]
        }
      }
    ],
    "output": {
      "kind": "computed_shape",
    "expr": "let x = shape(input(0, 0)) in let start = axis(param.start_dim, rank(input(0, 0))) in let end = axis(param.end_dim, rank(input(0, 0))) in let prefix = splice(slice(x, 0, start), start, [product(slice(x, start, end + 1))]) in splice(prefix, length(prefix), slice(x, end + 1))"
    },
    "to_dtype": "dtype(input(0, 0))",
    "constraints": [
      {
        "condition": "axis(param.start_dim, rank(input(0, 0))) <= axis(param.end_dim, rank(input(0, 0)))",
        "message": "start_dim must not follow end_dim"
      }
    ]
  }
}
