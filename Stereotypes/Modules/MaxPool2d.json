{
  "category": "Layer",
  "pythonClassName": "nn.MaxPool2d",
  "view": {
    "color": "#48d1cc",
    "width": 120,
    "height": 60
  },
  "params": {
    "kernel_size": {
      "type": "int | tuple",
      "default": "Undefined"
    },
    "stride": {
      "type": "int | tuple",
      "default": "None"
    },
    "padding": {
      "type": "int | tuple",
      "default": "0"
    },
    "dilation": {
      "type": "int | tuple",
      "default": "1"
    },
    "return_indices": {
      "type": "bool",
      "default": "False"
    },
    "ceil_mode": {
      "type": "bool",
      "default": "False"
    }
  },
  "type_signature": {
    "version": 2,
    "inputs": [
      {
        "lower": 1,
        "upper": 1,
        "pattern": {
          "kind": "pattern",
          "dims": [
            {
              "kind": "symbolic",
              "name": "B",
              "scope": "global"
            },
            {
              "kind": "symbolic",
              "name": "C",
              "scope": "local"
            },
            {
              "kind": "symbolic",
              "name": "H",
              "scope": "local"
            },
            {
              "kind": "symbolic",
              "name": "W",
              "scope": "local"
            }
          ]
        }
      }
    ],
    "output": {
      "kind": "pattern",
      "dims": [
        {
          "kind": "symbolic",
          "name": "B",
          "scope": "global"
        },
        {
          "kind": "symbolic",
          "name": "C",
          "scope": "local"
        },
        {
          "kind": "computed",
          "expr": "floor(($H + 2 * item(param.padding, 0) - item(param.dilation, 0) * (item(param.kernel_size, 0) - 1) - 1) / item(coalesce(param.stride, param.kernel_size), 0) + 1)"
        },
        {
          "kind": "computed",
          "expr": "floor(($W + 2 * item(param.padding, 1) - item(param.dilation, 1) * (item(param.kernel_size, 1) - 1) - 1) / item(coalesce(param.stride, param.kernel_size), 1) + 1)"
        }
      ]
    },
    "to_dtype": "dtype(input(0, 0))",
    "constraints": [
      {
      "condition": "item(param.kernel_size, 0) <= $H and item(param.kernel_size, 1) <= $W",
        "message": "kernel_size exceeds one or both input spatial dimensions",
        "severity": "warning",
        "category": "perf"
    }
    ,{
      "condition": "not param.ceil_mode",
      "message": "ceil_mode=true is not modelled by this signature"
    },
    {
      "condition": "not param.return_indices",
      "message": "return_indices=true produces an additional runtime output"
    }
    ]
  }
}
