{
  "category": "Layer",
  "pythonClassName": "nn.Softmax",
  "view": {
    "color": "#f4a460",
    "width": 100,
    "height": 50
  },
  "params": {
    "dim": {
      "type": "int",
      "default": "None"
    }
  },
  "type_signature": {
    "version": 2,
    "inputs": [
      {
        "lower": 1,
        "upper": 1,
        "pattern": {
          "kind": "pattern",
          "dims": [
            {
              "kind": "wildcard"
            }
          ]
        }
      }
    ],
    "output": {
      "kind": "pattern",
      "dims": [
        {
          "kind": "wildcard"
        }
      ]
    },
    "from_dtype": "float32",
    "to_dtype": "float32",
    "constraints": [
      {
        "condition": "between(param.dim, -rank(input(0, 0)), rank(input(0, 0)) - 1)",
        "message": "dim must select an existing axis"
      }
    ]
  }
}
