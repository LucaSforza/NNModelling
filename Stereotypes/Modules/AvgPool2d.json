{
  "category": "Layer",
  "pythonClassName": "nn.AvgPool2d",
  "view": {
    "color": "#48d1cc",
    "width": 120,
    "height": 60
  },
  "params": {
    "kernel_size": {
      "type": "int | tuple",
      "default": "Undefined"
    },
    "stride": {
      "type": "int | tuple",
      "default": "None"
    },
    "padding": {
      "type": "int | tuple",
      "default": "0"
    },
    "ceil_mode": {
      "type": "bool",
      "default": "False"
    },
    "count_include_pad": {
      "type": "bool",
      "default": "True"
    },
    "divisor_override": {
      "type": "int",
      "default": "None"
    }
  },
  "type_signature": {
    "version": 2,
    "inputs": [
      {
        "lower": 1,
        "upper": 1,
        "pattern": {
          "kind": "pattern",
          "dims": [
            {
              "kind": "symbolic",
              "name": "B",
              "scope": "global"
            },
            {
              "kind": "symbolic",
              "name": "C",
              "scope": "local"
            },
            {
              "kind": "symbolic",
              "name": "H",
              "scope": "local"
            },
            {
              "kind": "symbolic",
              "name": "W",
              "scope": "local"
            }
          ]
        }
      }
    ],
    "output": {
      "kind": "pattern",
      "dims": [
        {
          "kind": "symbolic",
          "name": "B",
          "scope": "global"
        },
        {
          "kind": "symbolic",
          "name": "C",
          "scope": "local"
        },
        {
          "kind": "computed",
          "expr": "floor(($H + 2 * item(param.padding, 0) - item(param.kernel_size, 0)) / item(coalesce(param.stride, param.kernel_size), 0) + 1)"
        },
        {
          "kind": "computed",
          "expr": "floor(($W + 2 * item(param.padding, 1) - item(param.kernel_size, 1)) / item(coalesce(param.stride, param.kernel_size), 1) + 1)"
        }
      ]
    },
  "to_dtype": "dtype(input(0, 0))",
  "constraints": [
    {
      "condition": "not param.ceil_mode",
      "message": "ceil_mode=true is not modelled by this signature"
    }
  ]
  }
}
