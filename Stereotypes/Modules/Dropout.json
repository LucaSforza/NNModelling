{
  "category": "Layer",
  "pythonClassName": "nn.Dropout",
  "view": {
    "color": "#a9a9a9",
    "width": 100,
    "height": 50
  },
  "params": {
    "p": {
      "type": "float",
      "default": "0.5"
    },
    "inplace": {
      "type": "bool",
      "default": "False"
    }
  },
  "type_signature": {
    "version": 2,
    "inputs": [
      {
        "lower": 1,
        "upper": 1,
        "pattern": {
          "kind": "pattern",
          "dims": [
            {
              "kind": "wildcard"
            }
          ]
        }
      }
    ],
    "output": {
      "kind": "pattern",
      "dims": [
        {
          "kind": "wildcard"
        }
      ]
    },
    "from_dtype": "float32",
    "to_dtype": "float32",
    "constraints": [
      {
      "condition": "param.p <= 0.5",
        "message": "Dropout rate > 0.5: more than half of activations are dropped",
        "severity": "warning",
      "category": "perf"
    },
    {
      "condition": "between(param.p, 0, 1)",
      "message": "Dropout probability must be in [0, 1]"
      }
    ]
  }
}
