{
  "category": "Layer",
  "pythonClassName": "nn.Upsample",
  "view": {
    "color": "#48d1cc",
    "width": 120,
    "height": 60
  },
  "params": {
    "size": {
      "type": "int | tuple | list",
      "default": "None"
    },
    "scale_factor": {
      "type": "float | tuple",
      "default": "None"
    },
    "mode": {
      "type": "str",
      "default": "nearest"
    },
    "align_corners": {
      "type": "bool",
      "default": "None"
    }
  },
  "type_signature": {
    "version": 2,
    "inputs": [
      {
        "lower": 1,
        "upper": 1,
        "pattern": {
          "kind": "pattern",
          "dims": [
            {
              "kind": "symbolic",
              "name": "B",
              "scope": "global"
            },
            {
              "kind": "symbolic",
              "name": "C",
              "scope": "local"
            },
            {
              "kind": "symbolic",
              "name": "H",
              "scope": "local"
            },
            {
              "kind": "symbolic",
              "name": "W",
              "scope": "local"
            }
          ]
        }
      }
    ],
    "output": {
      "kind": "pattern",
      "dims": [
        {
          "kind": "symbolic",
          "name": "B",
          "scope": "global"
        },
        {
          "kind": "symbolic",
          "name": "C",
          "scope": "local"
        },
        {
          "kind": "computed",
          "expr": "item(coalesce(param.size, floor($H * item(param.scale_factor, 0))), 0)"
        },
        {
          "kind": "computed",
          "expr": "item(coalesce(param.size, floor($W * item(param.scale_factor, 1))), 1)"
        }
      ]
    },
    "to_dtype": "dtype(input(0, 0))"
  }
}
