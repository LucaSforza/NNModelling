{
  "category": "Layer",
  "pythonClassName": "nn.Conv1d",
  "view": {
    "color": "#20b2aa",
    "width": 140,
    "height": 60
  },
  "params": {
    "in_channels": {
      "type": "int",
      "default": "Undefined",
      "position": "top"
    },
    "out_channels": {
      "type": "int",
      "default": "Undefined",
      "position": "bottom"
    },
    "kernel_size": {
      "type": "int | tuple",
      "default": "Undefined"
    },
    "stride": {
      "type": "int | tuple",
      "default": "1"
    },
    "padding": {
      "type": "int | tuple | str",
      "default": "0"
    },
    "dilation": {
      "type": "int | tuple",
      "default": "1"
    },
    "groups": {
      "type": "int",
      "default": "1"
    },
    "bias": {
      "type": "bool",
      "default": "True"
    },
    "padding_mode": {
      "type": "str",
      "default": "zeros"
    },
    "device": {
      "type": "str",
      "default": "None"
    },
    "dtype": {
      "type": "str",
      "default": "None"
    }
  },
  "type_signature": {
    "version": 2,
    "inputs": [
      {
        "lower": 1,
        "upper": 1,
        "pattern": {
          "kind": "pattern",
          "dims": [
            {
              "kind": "symbolic",
              "name": "B",
              "scope": "global"
            },
            {
              "kind": "param_ref",
              "name": "in_channels"
            },
            {
              "kind": "symbolic",
              "name": "L",
              "scope": "local"
            }
          ]
        }
      }
    ],
    "output": {
      "kind": "pattern",
      "dims": [
        {
          "kind": "symbolic",
          "name": "B",
          "scope": "global"
        },
        {
          "kind": "param_ref",
          "name": "out_channels"
        },
        {
          "kind": "computed",
          "expr": "floor(($L + 2 * item(param.padding, 0) - item(param.dilation, 0) * (item(param.kernel_size, 0) - 1) - 1) / item(param.stride, 0) + 1)"
        }
      ]
    },
    "to_dtype": "dtype(input(0, 0))",
    "constraints": [
      {
      "condition": "item(param.kernel_size, 0) <= $L",
        "message": "kernel_size exceeds input spatial dimension",
        "severity": "warning",
        "category": "perf"
      }
    ]
  }
}
