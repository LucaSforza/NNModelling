{
  "name": "Input",
  "description": "Introduces a declared tensor type as a model input.",
  "kind": "input",
  "view": {
    "color": "#3f8f68",
    "width": 180,
    "height": 100
  },
  "parameters": {
    "shape": {
      "type": "shape",
      "default": ["B", 28, 28],
      "position": "top"
    },
    "dtype": {
      "type": "dtype",
      "choices": ["float16", "bfloat16", "float32", "float64", "int8", "uint8", "int16", "int32", "int64", "bool"],
      "default": "float32"
    }
  }
}
